[PLATFORMS]
ALL

[PERMUTATIONS]

[RENDERSTATE]

BlendingEnabled0 = true
DestBlend0 = Blend_InvSrcAlpha
SourceBlend0 = Blend_SrcAlpha
DestBlendAlpha0 = Blend_InvSrcAlpha
DepthTest = false
DepthWrite = false
CullMode = CullMode_None
ScissorTest = true

[VERTEXSHADER]

#include <Shaders/Common/GlobalConstants.h>
#include "GameUiInterpolator.h"

VS_OUT main(VS_IN Input)
{
  VS_OUT RetVal;

  float2 screenPosition = (Input.Position.xy * ViewportSize.zw) * float2(2.0, -2.0) + float2(-1.0, 1.0);
  RetVal.Position = float4(screenPosition, Input.Position.z, 1.0f);

  RetVal.TexCoord0 = Input.TexCoord0;
  RetVal.Color0 = Input.Color0;
  RetVal.SdfCoord = Input.SdfCoord;
  RetVal.SdfParams = Input.SdfParams;
  RetVal.SdfRadii = Input.SdfRadii;
  RetVal.ColorB = Input.ColorB;

  return RetVal;
}


[PIXELSHADER]

#include "GameUiInterpolator.h"

Texture2D BaseTexture;
SamplerState BaseTexture_AutoSampler;

float4 main(PS_IN Input) : SV_Target
{
  // signed distance field: 0.5 = glyph edge, anti-aliased over one screen pixel;
  // the floor (~1.5/255) masks R8 quantization lumps when text is strongly magnified
  float dist = BaseTexture.Sample(BaseTexture_AutoSampler, Input.TexCoord0.xy).r;
  float w = max(fwidth(dist), 0.006);
  float alpha = smoothstep(0.5 - w, 0.5 + w, dist);

  return float4(Input.Color0.rgb, Input.Color0.a * alpha);
}
