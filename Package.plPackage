// plasma.gameui — Game UI.
//
// The AUTHORED manifest, kept in source next to the plugin. Component hashes and sizes are NOT
// here: the packaging step computes those and emits them into the published manifest.
//
// Field reference and validation rules: Docs/PluginPackageManagerPlan.html §05.

PackageInfo
{
	string %Id{"plasma.gameui"}
	string %Version{"1.4.1"}
	string %Publisher{"PlasmaTechnology"}
	string %License{"MIT"}
	string %Homepage{"https://plasmagameengine.com"}

	string %MinEngineVersion{"0.11.2"}
	string %MaxEngineVersion{"0.11.2"}
	string %AbiTag{"win64-msvc19-0.11.2-abi6-dev"}

	string %DisplayName{"Game UI"}
	string %Category{"UI"}
	string %Description{"Engine-native game UI framework: UI Document, UI Style and UI Font assets with a visual canvas editor, text that fits its content, a Text fit report per language, and world-space canvases for terminals, signs and nameplates.

The Game UI runtime (plGameUiPlugin) ships with the engine; this package adds its editor. FreeType ships with the package under the FreeType License; the font asset uses it to rasterise glyphs."}
	string %Icon{"Branding/GameUiIcon.png"}
	string %Banner{"Branding/GameUiBanner.png"}

	string %EditorPlugins{"plEditorPluginGameUi"}
	string %EditorEnginePlugins{"plEnginePluginGameUi"}
	// The runtime is built by the engine (its editor UI runs on it); listing it here is what loads it in a game.
	string %RuntimePlugins{"plGameUiPlugin"}
	string %PackageDependencies{"freetype.dll", "freetype-LICENSE.txt"}

	// ---- dependencies ---------------------------------------------------------
	// The editor plugin builds on EditorPluginAssets, so it must load after it.
	Requires { string %Id{"plasma.assets"} string %Range{"^1.0"} }

	// ---- components -----------------------------------------------------------
	// The Game UI shaders ship with the engine's runtime (Data/Base/Shaders), so the package mounts no assets.
	Component { string %Name{"manifest"} string %Platform{"any"} }
	Component { string %Name{"runtime-win64"} string %Platform{"win64"} }
	Component { string %Name{"editor-win64"} string %Platform{"win64"} }
	Component { string %Name{"icon"} string %Platform{"any"} }
	Component { string %Name{"banner"} string %Platform{"any"} }
	Component { string %Name{"tool"} string %Platform{"any"} string %Path{"EditorIcons"} }
}
